# Copiar a freeradius/.env y completar. El .env NO se sube al repo.

# Shared secret con R1 (tiene que coincidir con /radius en el MikroTik)
RADIUS_SECRET_R1=cambiar-secret-r1

# Shared secret para probar con radtest desde la VM
RADIUS_SECRET_LOCAL=testing123

# Conexión a PostgreSQL (VM db)
DB_HOST=10.10.10.20
DB_RADIUS_PASSWORD=cambiar-password-radius

# Secret del virtual server "status" (freeradius/status), lo usa freeradius-exporter
RADIUS_STATUS_SECRET=cambiar-secret-status

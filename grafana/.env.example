# Copiar a grafana/.env y completar. El .env NO se sube al repo.

# Admin de la interfaz web de Grafana (http://localhost:3000)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=cambiar-password-admin-grafana

# Usuario de solo lectura de PostgreSQL (VM db).
# Tiene que coincidir con GRAFANA_DB_PASSWORD de db/.env
GRAFANA_DB_PASSWORD=cambiar-password-grafana

# Usuario de solo lectura en R1 (/user group con policy=api,read)
# para los exporters que leen el router por la API (puerto 8728)
R1_API_USER=monitor
R1_API_PASSWORD=cambiar-password-monitor

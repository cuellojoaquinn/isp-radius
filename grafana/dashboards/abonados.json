    {
      "type": "stat",
      "title": "Abonados",
      "description": "Activos = en un plan. Suspendidos = por falta de pago (facturación). Conectados ahora = con sesión abierta en el accounting.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-radius"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-radius"
          },
          "rawSql": "SELECT count(*) FILTER (WHERE g.groupname NOT IN ('moroso', 'baja')) AS \"Activos\",\n       count(*) FILTER (WHERE g.groupname = 'moroso')                AS \"Suspendidos\",\n       count(*) FILTER (WHERE g.groupname = 'baja')                  AS \"De baja\",\n       (SELECT count(*) FROM radacct WHERE acctstoptime IS NULL)     AS \"Conectados ahora\"\nFROM (SELECT DISTINCT ON (username) username, groupname FROM radusergroup ORDER BY username, priority) g\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",

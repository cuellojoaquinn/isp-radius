    {
      "type": "timeseries",
      "title": "Velocidad del abonado",
      "description": "Medido en R1, en la interfaz de la sesión PPPoE. El tope es el del plan (cola en R1). Sin línea = no estaba conectado.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(mktxp_interface_rx_byte_total{name=\"<pppoe-$abonado>\"}[$__rate_interval]) * 8",
          "legendFormat": "sube",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(mktxp_interface_tx_byte_total{name=\"<pppoe-$abonado>\"}[$__rate_interval]) * 8",

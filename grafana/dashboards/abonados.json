    {
      "type": "table",
      "title": "Sesiones (las últimas 30)",
      "description": "Del accounting (radacct). En rojo, los cortes anormales. Horas en la zona del navegador.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-radius"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-radius"
          },
          "rawSql": "SELECT acctstarttime AS \"Conectó\",\n       acctstoptime AS \"Desconectó\",\n       EXTRACT(EPOCH FROM COALESCE(acctstoptime, acctupdatetime, now()) - acctstarttime) AS \"Duración\",\n       host(framedipaddress) AS \"IP\",\n       acctinputoctets AS \"Subió\",\n       acctoutputoctets AS \"Bajó\",\n       CASE acctterminatecause\n      WHEN 'User-Request' THEN 'El abonado cortó'\n      WHEN 'Session-Timeout' THEN 'Tiempo máximo de sesión'\n      WHEN 'Idle-Timeout' THEN 'Inactividad'\n      WHEN 'Admin-Reset' THEN 'Un operador o facturación lo cortó'\n      WHEN 'NAS-Request' THEN 'Sacado desde R1'\n      WHEN 'Lost-Carrier' THEN 'Se perdió el enlace'\n      WHEN 'Lost-Service' THEN 'Se perdió el servicio'\n      WHEN 'NAS-Error' THEN 'Error de R1'\n      WHEN 'NAS-Reboot' THEN 'R1 se reinició'\n      WHEN 'Port-Error' THEN 'Error de puerto'\n      ELSE CASE WHEN acctstoptime IS NULL THEN 'Sigue conectado' ELSE 'Sin causa informada' END\n    END AS \"Cómo terminó\"\nFROM radacct WHERE username = '$abonado'\nORDER BY acctstarttime DESC LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Sin sesiones registradas"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Desconectó"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duración"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Subió"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bajó"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cómo terminó"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Se perdió el enlace": {
                        "text": "Se perdió el enlace",
                        "color": "red",
                        "index": 0
                      },
                      "Se perdió el servicio": {
                        "text": "Se perdió el servicio",
                        "color": "red",
                        "index": 1
                      },
                      "Error de R1": {
                        "text": "Error de R1",
                        "color": "red",
                        "index": 2
                      },
                      "R1 se reinició": {
                        "text": "R1 se reinició",
                        "color": "red",
                        "index": 3
                      },
                      "Error de puerto": {
                        "text": "Error de puerto",
                        "color": "red",
                        "index": 4

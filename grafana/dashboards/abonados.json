    {
      "type": "table",
      "title": "Resultados de la búsqueda",
      "description": "Coincidencias por usuario (parte del nombre), IP (actual o de una sesión anterior), MAC del equipo o nombre del cliente. Máximo 50. Click en el abonado para ver su ficha.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-radius"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-radius"
          },
          "rawSql": "WITH b AS (SELECT trim(${buscar:sqlstring}) AS t),\ncand AS (\n  SELECT g.username FROM radusergroup g, b WHERE b.t <> '' AND g.username ILIKE '%' || b.t || '%'\n  UNION\n  SELECT r.username FROM radacct r, b\n   WHERE r.framedipaddress = (CASE WHEN b.t ~ '^[0-9]{1,3}(\\.[0-9]{1,3}){3}$' THEN b.t END)::inet\n  UNION\n  SELECT r.username FROM radacct r, b WHERE b.t <> '' AND r.callingstationid = upper(b.t)\n  UNION\n  SELECT s.radius_username FROM facturacion.servicio s JOIN facturacion.cliente c ON c.id = s.cliente_id, b\n   WHERE b.t <> '' AND c.nombre ILIKE '%' || b.t || '%'\n)\nSELECT c.username AS \"Abonado\",\n       cl.nombre AS \"Cliente\",\n       g.groupname AS \"Plan o estado\",\n       CASE WHEN u.acctstarttime IS NOT NULL AND u.acctstoptime IS NULL THEN 'Conectado' ELSE 'Desconectado' END AS \"Ahora\",\n       host(u.framedipaddress) AS \"IP\",\n       u.callingstationid AS \"MAC\",\n       u.acctstarttime AS \"Última conexión\"\nFROM (SELECT DISTINCT username FROM cand) c\nLEFT JOIN LATERAL (SELECT * FROM radacct r WHERE r.username = c.username ORDER BY r.acctstarttime DESC LIMIT 1) u ON true\nLEFT JOIN LATERAL (SELECT groupname FROM radusergroup x WHERE x.username = c.username ORDER BY priority LIMIT 1) g ON true\nLEFT JOIN facturacion.servicio s ON s.radius_username = c.username\nLEFT JOIN facturacion.cliente cl ON cl.id = s.cliente_id\nORDER BY length(c.username), c.username\nLIMIT 50\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Escribí arriba un usuario, una IP, una MAC o el nombre del cliente"
        },

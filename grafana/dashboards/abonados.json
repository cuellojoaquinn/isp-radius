    {
      "type": "table",
      "title": "Abonados con problemas",
      "description": "Logins rechazados en la última hora (contraseña, usuario inexistente o suspendido), cortes anormales en 24 h (se perdió el enlace o el servicio) y sesiones abiertas sin aviso de accounting hace más de 11 min. Los cortes porque R1 se reinició no se listan: son de R1, no de cada abonado (alerta R1Reiniciado). Click en el abonado para ver su ficha.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-radius"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-radius"
          },
          "rawSql": "WITH rech AS (\n  SELECT username, count(*) AS n, max(authdate) AS ult\n    FROM radpostauth\n   WHERE reply = 'Access-Reject' AND authdate > now() - interval '1 hour'\n   GROUP BY username\n)\nSELECT abonado AS \"Abonado\", problema AS \"Problema\", detalle AS \"Detalle\", cuando AS \"Último\" FROM (\n  SELECT r.username AS abonado,\n         CASE g.groupname WHEN 'moroso' THEN 'Suspendido y sigue intentando'\n                          WHEN 'baja'   THEN 'Dado de baja y sigue intentando'\n                          ELSE 'Logins rechazados' END AS problema,\n         r.n || ' rechazos en la última hora' AS detalle, r.ult AS cuando, 1 AS orden\n    FROM rech r\n    LEFT JOIN LATERAL (SELECT groupname FROM radusergroup x WHERE x.username = r.username ORDER BY priority LIMIT 1) g ON true\n  UNION ALL\n  SELECT username, 'Corte anormal',\n         CASE acctterminatecause WHEN 'Lost-Carrier' THEN 'Se perdió el enlace' WHEN 'Lost-Service' THEN 'Se perdió el servicio'\n              WHEN 'NAS-Error' THEN 'Error de R1' ELSE 'Error de puerto' END || ' (' || count(*) || ' en 24 h)',\n         max(acctstoptime), 2\n    FROM radacct\n   WHERE acctstoptime > now() - interval '24 hours'\n     AND acctterminatecause IN ('Lost-Carrier', 'Lost-Service', 'NAS-Error', 'Port-Error')\n   GROUP BY username, acctterminatecause\n  UNION ALL\n  SELECT username, 'Accounting atrasado',\n         'sin aviso hace ' || (extract(epoch FROM now() - acctupdatetime)::int / 60) || ' min (¿sesión fantasma?)',\n         acctupdatetime, 3\n    FROM radacct\n   WHERE acctstoptime IS NULL AND acctupdatetime < now() - interval '11 minutes'\n) p\nORDER BY orden, cuando DESC\nLIMIT 100\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Ningún abonado con problemas"
        },
        "overrides": [

          {
            "matcher": {
              "id": "byName",
              "options": "Problema"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Logins rechazados": {
                        "text": "Logins rechazados",
                        "color": "orange",
                        "index": 0
                      },
                      "Suspendido y sigue intentando": {
                        "text": "Suspendido y sigue intentando",
                        "color": "yellow",
                        "index": 1
                      },
                      "Dado de baja y sigue intentando": {
                        "text": "Dado de baja y sigue intentando",
                        "color": "#8E8E8E",
                        "index": 2
                      },
                      "Corte anormal": {
                        "text": "Corte anormal",
                        "color": "red",
                        "index": 3
                      },
                      "Accounting atrasado": {
                        "text": "Accounting atrasado",
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false

    {
      "type": "bargauge",
      "title": "Los 10 que más consumen (24 h, del accounting)",
      "description": "Suma de subida y bajada de sus sesiones de las últimas 24 h, según el accounting (lo que se factura). Sirve para ver abusos o un equipo infectado. Click en la barra para ver la ficha.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-radius"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-radius"
          },
          "rawSql": "SELECT username AS abonado, sum(acctinputoctets + acctoutputoctets) AS bytes\nFROM radacct\nWHERE acctstoptime IS NULL OR acctstoptime > now() - interval '24 hours'\nGROUP BY username\nORDER BY bytes DESC\nLIMIT 10\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",

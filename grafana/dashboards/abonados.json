    {
      "type": "bargauge",
      "title": "Abonados activos por plan",
      "description": "Plan contratado (grupo en RADIUS).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-radius"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-radius"
          },
          "rawSql": "SELECT g.groupname AS plan, count(*) AS abonados\nFROM (SELECT DISTINCT ON (username) username, groupname FROM radusergroup ORDER BY username, priority) g\nWHERE g.groupname NOT IN ('moroso', 'baja')\nGROUP BY 1 ORDER BY 2 DESC\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }

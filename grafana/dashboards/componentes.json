{
  "uid": "componentes",
  "title": "Componentes",
  "description": "Causas: las cuatro señales doradas de R1 (cliente RADIUS y servidor PPPoE) y FreeRADIUS (bitácora 18/11). La base está en el dashboard PostgreSQL.",
  "tags": [
    "isp-radius",
    "causas"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "title": "Servicio RADIUS (SLOs)",
      "type": "link",
      "url": "/d/slos",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/postgresql",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Infraestructura",
      "type": "link",
      "url": "/d/infraestructura",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/logs",
      "icon": "doc",
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "R1 como cliente RADIUS (/radius monitor) — lo que vio el NAS",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tráfico · pedidos por minuto",
      "description": "Incluye accounting: una reconexión suma 3 (Stop + Access-Request + Start).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(routeros_radius_requests_total[$__rate_interval])) * 60",
          "legendFormat": "requests"
        },
        {
          "refId": "B",
          "expr": "sum(rate(routeros_radius_accepts_total[$__rate_interval])) * 60",
          "legendFormat": "accepts"
        },
        {
          "refId": "C",
          "expr": "sum(rate(routeros_radius_rejects_total[$__rate_interval])) * 60",
          "legendFormat": "rejects"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errores · timeouts y bad-replies",
      "description": "timeouts sin pedidos en FreeRADIUS (abajo) = red o servidor caído; bad-replies = shared secret distinto entre R1 y FreeRADIUS.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(routeros_radius_timeouts_total[$__rate_interval]))",
          "legendFormat": "timeouts (servidor no responde)"
        },
        {
          "refId": "B",
          "expr": "sum(increase(routeros_radius_bad_replies_total[$__rate_interval]))",
          "legendFormat": "bad-replies (secret distinto)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "timeouts.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latencia · reenvíos y RTT",
      "description": "El RTT es una muestra suelta (no un percentil): solo de referencia, no es SLI.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(routeros_radius_resends_total[$__rate_interval]))",
          "legendFormat": "reenvíos"
        },
        {
          "refId": "B",
          "expr": "max(routeros_radius_last_request_rtt_seconds)",
          "legendFormat": "RTT último pedido"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RTT último pedido"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Saturación · pendientes",
      "description": "Pedidos esperando respuesta. Si crece, el servidor no da abasto.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(routeros_radius_pending)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Exporter de R1",
      "description": "0 = no puede leer R1 por la API (alerta R1SinAcceso).",
      "gridPos": {
        "x": 4,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "routeros_exporter_up",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "FreeRADIUS (Status-Server) — lo que recibió el servidor",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "stat",
      "title": "FreeRADIUS",
      "description": "0 = el exporter no puede consultar al servidor: FreeRADIUS caído.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "freeradius_up",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "NAS vs servidor · pedidos en 5 min",
      "description": "Si R1 envía y el servidor no recibe, el problema está entre los dos (red, firewall) o el servidor está caído.",
      "gridPos": {
        "x": 4,
        "y": 14,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(routeros_radius_requests_total[5m]))",
          "legendFormat": "enviados por R1"
        },
        {
          "refId": "B",
          "expr": "sum(increase(freeradius_total_access_requests[5m])) + sum(increase(freeradius_total_acct_requests[5m]))",
          "legendFormat": "recibidos por FreeRADIUS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Respuestas y descartes",
      "description": "Descartados = recibidos sin respuesta (servidor saturado o base lenta).",
      "gridPos": {
        "x": 14,
        "y": 14,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(freeradius_total_access_accepts[$__rate_interval])) * 60",
          "legendFormat": "accepts/min"
        },
        {
          "refId": "B",
          "expr": "sum(rate(freeradius_total_access_rejects[$__rate_interval])) * 60",
          "legendFormat": "rejects/min"
        },
        {
          "refId": "C",
          "expr": "sum(increase(freeradius_total_auth_dropped_requests[$__rate_interval])) + sum(increase(freeradius_total_acct_dropped_requests[$__rate_interval]))",
          "legendFormat": "descartados"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Saturación · colas internas",
      "description": "Pedidos esperando un thread. Crece si la base responde lento.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(freeradius_queue_len_auth)",
          "legendFormat": "auth"
        },
        {
          "refId": "B",
          "expr": "max(freeradius_queue_len_acct)",
          "legendFormat": "acct"
        },
        {
          "refId": "C",
          "expr": "max(freeradius_queue_len_internal)",
          "legendFormat": "internal"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Error del Status-Server",
      "description": "El exporter siempre publica freeradius_stats_error=1; el error real está en la etiqueta \"error\" (vacía = sin error).",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(freeradius_stats_error{error!=\"\"}) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "R1 como servidor PPPoE y como equipo",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Sesiones PPPoE activas",
      "description": "Locales debería ser 0: los abonados se gestionan solo en FreeRADIUS.",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(routeros_ppp_active_sessions{radius=\"yes\"})",
          "legendFormat": "por RADIUS",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum(routeros_ppp_active_sessions{radius=\"no\"})",
          "legendFormat": "locales",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Pool pool-pppoe usado",
      "description": "Saturación: sin IPs libres el abonado se autentica pero no navega (alerta al 80 %).",
      "gridPos": {
        "x": 6,
        "y": 29,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mktxp_ip_pool_used{pool=\"pool-pppoe\"} / mktxp_ip_pool_total{pool=\"pool-pppoe\"}",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },

    {
      "id": 18,
      "type": "timeseries",
      "title": "Tráfico por abonado",
      "description": "Cada sesión PPPoE es una interfaz dinámica <pppoe-usuario> en R1. Visto desde R1: rx = lo que sube el abonado. Tope del plan: cola de 50M.",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mktxp_interface_rx_byte_total{name=~\"<pppoe-.*>\"}[$__rate_interval]) * 8",
          "legendFormat": "{{name}} subida"
        },
        {
          "refId": "B",
          "expr": "-rate(mktxp_interface_tx_byte_total{name=~\"<pppoe-.*>\"}[$__rate_interval]) * 8",
          "legendFormat": "{{name}} bajada"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Tráfico de interfaces de R1",
      "description": "ether1 = gestión (RADIUS, API), vlan-acceso = abonados, ether2 = LAN1.",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mktxp_interface_rx_byte_total{name!~\"<pppoe-.*>|lo\"}[$__rate_interval]) * 8",
          "legendFormat": "{{name}} rx"
        },
        {
          "refId": "B",
          "expr": "-rate(mktxp_interface_tx_byte_total{name!~\"<pppoe-.*>|lo\"}[$__rate_interval]) * 8",
          "legendFormat": "{{name}} tx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10,

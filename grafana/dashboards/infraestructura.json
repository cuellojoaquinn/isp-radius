    {
      "type": "stat",
      "title": "Días hasta llenar el disco (al ritmo de las últimas 6 h)",
      "description": "Si el espacio libre sigue bajando como en las últimas 6 h, en cuántos días se llena. Es lo que mira la alerta de disco para avisar antes del borde.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"rootfs\"} / clamp_min(-deriv(node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"rootfs\"}[6h]), 1) / 86400, \"maquina\", \"VM $1\", \"instance\", \"(.*)\")",
          "legendFormat": "{{maquina}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 365,
                "to": 1000000000000000.0,
                "result": {
                  "text": "Más de un año",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,

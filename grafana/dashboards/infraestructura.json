    {
      "type": "stat",
      "title": "Tiempo encendido",
      "description": "Desde el último arranque. Naranja = se reinició en la última hora. Si R1 se reinicia sin apagarse bien, corta a todos los abonados (causa 'R1 se reinició').",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(time() - node_boot_time_seconds, \"maquina\", \"VM $1\", \"instance\", \"(.*)\")",
          "legendFormat": "{{maquina}}",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(max(mktxp_system_uptime), \"maquina\", \"R1\", \"\", \"\")",
          "legendFormat": "{{maquina}}",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 3600
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true,

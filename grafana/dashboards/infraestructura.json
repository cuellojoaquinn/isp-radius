{
  "uid": "infraestructura",
  "title": "Infraestructura",
  "description": "¿Las máquinas aguantan? Las 3 VMs y R1 como equipo: si llegan los datos, procesador, memoria, disco, reinicios y red. Lo que hace cada servicio está en Componentes.",
  "tags": [
    "isp-radius",
    "causas"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "links": [
    {
      "title": "Mapa",
      "type": "link",
      "url": "/d/mapa",
      "icon": "apps",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Servicio",
      "type": "link",
      "url": "/d/slos",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Abonados",
      "type": "link",
      "url": "/d/abonados",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Componentes",
      "type": "link",
      "url": "/d/componentes",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/postgresql",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/logs",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }

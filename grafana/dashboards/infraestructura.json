  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "¿Llegan los datos? Fuentes que consulta Prometheus",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Fuentes de datos",
      "description": "Exportadores y servicios que Prometheus consulta cada 15 s. Si alguno no responde, los paneles que dependen de él muestran datos viejos o vacíos (alerta TargetCaido a los 2 min).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up == 0) or vector(0)",
          "legendFormat": "sin responder",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up)",
          "legendFormat": "en total",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "transparent"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      }
    },
    {
      "type": "table",
      "title": "Fuentes que no responden",
      "description": "Solo aparecen las caídas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up == 0",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "Todas responden"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Fuente"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "alertmanager": {
                        "text": "Alertmanager (manda las alertas)",
                        "color": "red",
                        "index": 0
                      },
                      "node": {
                        "text": "Máquina virtual (node-exporter)",
                        "color": "red",
                        "index": 1
                      },
                      "prometheus": {
                        "text": "Prometheus",
                        "color": "red",
                        "index": 2
                      },
                      "postgres": {
                        "text": "PostgreSQL (exportador)",
                        "color": "red",
                        "index": 3
                      },
                      "r1-radius": {
                        "text": "R1: RADIUS",
                        "color": "red",
                        "index": 4
                      },
                      "r1-mktxp": {
                        "text": "R1: equipo e interfaces",
                        "color": "red",
                        "index": 5
                      },
                      "freeradius": {
                        "text": "FreeRADIUS (exportador)",
                        "color": "red",
                        "index": 6
                      },
                      "loki": {
                        "text": "Loki (guarda los logs)",
                        "color": "red",
                        "index": 7
                      },
                      "alloy": {
                        "text": "Alloy (envía los logs)",
                        "color": "red",
                        "index": 8
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "service": true
            },
            "renameByName": {
              "job": "Fuente",
              "instance": "Dónde"
            }
          }
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 16,
        "h": 4
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Recursos de cada máquina ahora (las 3 VMs y R1)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Procesador en uso",
      "description": "Promedio de todos los núcleos. Sostenido arriba de 90 %, la máquina no da abasto.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])), \"maquina\", \"VM $1\", \"instance\", \"(.*)\") or label_replace(max(mktxp_system_cpu_load) / 100, \"maquina\", \"R1\", \"\", \"\")",
          "legendFormat": "{{maquina}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "bargauge",
      "title": "Memoria en uso",
      "description": "R1 es un CHR con 256 MB: alrededor de 80 % es su uso normal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes, \"maquina\", \"VM $1\", \"instance\", \"(.*)\") or label_replace(1 - max(mktxp_system_free_memory) / max(mktxp_system_total_memory), \"maquina\", \"R1\", \"\", \"\")",
          "legendFormat": "{{maquina}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",

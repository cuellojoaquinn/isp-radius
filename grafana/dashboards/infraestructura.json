    {
      "type": "timeseries",
      "title": "Red de gestión: recibe (arriba) y envía (abajo)",
      "description": "La red 10.10.10.0/24 por donde viajan RADIUS, la base, las métricas y los logs (eth1 en las VMs, ether1 en R1). Lo enviado se dibuja hacia abajo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(rate(node_network_receive_bytes_total{device=\"eth1\"}[$__rate_interval]) * 8, \"maquina\", \"VM $1\", \"instance\", \"(.*)\")",
          "legendFormat": "{{maquina}} recibe",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(rate(node_network_transmit_bytes_total{device=\"eth1\"}[$__rate_interval]) * 8, \"maquina\", \"VM $1\", \"instance\", \"(.*)\")",
          "legendFormat": "{{maquina}} envía",
          "instant": false,
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"

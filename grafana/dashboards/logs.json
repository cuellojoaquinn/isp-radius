{
  "uid": "logs",
  "title": "Logs",
  "tags": [
    "isp-radius",
    "logs"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "description": "Logs de las VMs (journal vía Alloy) y de R1 (syslog) en Loki. Retención 14 días.",
  "links": [
    {
      "title": "Servicio RADIUS (SLOs)",
      "type": "link",
      "url": "/d/slos",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Componentes",
      "type": "link",
      "url": "/d/componentes",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/postgresql",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Infraestructura",
      "type": "link",
      "url": "/d/infraestructura",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "VM",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "query": "freeradius,db,grafana,r1",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": "freeradius|db|grafana|r1"
      },
      {
        "name": "usuario",
        "label": "Usuario / MAC / texto",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Panorama — cuánto loguea cada parte y cuántos errores",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Líneas por servicio",
      "description": "Un salto de volumen suele ser un problema (reintentos, errores en bucle) o alguien que dejó un modo debug.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({instance=~\"$instance\"} [$__auto]))",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Líneas con error por instancia",
      "description": "Búsqueda de texto (error, fatal, failed...): es orientativa, no un SLI.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance) (count_over_time({instance=~\"$instance\"} |~ \"(?i)\\\\b(error|fatal|panic|critical|failed)\\\\b\" [$__auto]))",
          "legendFormat": "{{instance}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Autenticación — qué le pasó a cada login (FreeRADIUS)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Logins por resultado (del log)",
      "description": "Por minuto. Métricas que calcula el ruler de Loki (grafana/loki/rules/). Incluye los logins de test.sh (cliente dockernet).",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "radius:login_ok:rate5m * 60",
          "legendFormat": "Login OK"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "radius:login_incorrecto:rate5m * 60",
          "legendFormat": "Login incorrect"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "radius:sql_errores:rate5m * 60",
          "legendFormat": "errores rlm_sql"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logins (filtrar por usuario arriba)",
      "description": "Login OK / Login incorrect con el motivo, el cliente (r1, dockernet) y la MAC (cli). Sin contraseñas.",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=\"freeradius\"} |= \"Auth:\" |= \"$usuario\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "FreeRADIUS · errores (base, módulos)",
      "description": "rlm_sql = FreeRADIUS no llega a PostgreSQL (alerta FreeradiusSinBase).",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=\"freeradius\"} |~ \"Error|Warning\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "PostgreSQL",
      "description": "Arranques, conexiones rechazadas por pg_hba, errores de consultas.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=\"postgres\"} |~ \"$usuario\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "R1 — eventos del NAS (syslog)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "logs",
      "title": "R1 · PPPoE (conexiones y cortes)",
      "description": "logged in / logged out (con bytes y MAC), authenticated, terminating. Lado del NAS del mismo login que ve FreeRADIUS.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{instance=\"r1\", topic=\"ppp\"} |= \"$usuario\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "R1 · RADIUS y sistema",
      "description": "Timeouts de RADIUS, cambios de configuración (quién y qué), logins de administradores.",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{instance=\"r1\", topic=~\"radius|sistema\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Sistema de las VMs — lo que no está en los contenedores",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Kernel y servicios del sistema",
      "description": "OOM killer (out of memory: Killed process), disco, red, dockerd, accesos por SSH.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{instance=~\"$instance\", unit=~\"kernel|docker.service|containerd.service|ssh.service\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
  ]
}
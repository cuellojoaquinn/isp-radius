{
  "uid": "logs",
  "title": "Logs",
  "description": "Exploración de logs: las VMs (journal vía Alloy), R1 (syslog) y los jobs de facturación, en Loki, 14 días. El texto de arriba filtra todos los paneles. Lo de un abonado puntual está en Abonados.",
  "tags": [
    "isp-radius",
    "logs"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "links": [
    {
      "title": "Mapa",
      "type": "link",
      "url": "/d/mapa",
      "icon": "apps",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Servicio",
      "type": "link",
      "url": "/d/slos",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Abonados",
      "type": "link",
      "url": "/d/abonados",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Componentes",
      "type": "link",
      "url": "/d/componentes",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/postgresql",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Infraestructura",
      "type": "link",
      "url": "/d/infraestructura",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "maquina",
        "label": "Máquina",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "query": "VM freeradius : freeradius,VM db : db,VM grafana : grafana,R1 : r1",
        "allValue": "freeradius|db|grafana|r1",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "texto",
        "label": "Buscar texto",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Panorama: cuánto escribe cada máquina",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Líneas de log por máquina",
      "description": "Un salto de volumen suele ser un problema (reintentos, errores en bucle) o alguien que dejó un modo de depuración prendido.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance) (count_over_time({instance=~\"$maquina\"} [$__auto]))",
          "legendFormat": "{{instance}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisLabel": "",
            "showPoints": "never",
            "spanNulls": false,
            "barAlignment": 0,
            "axisSoftMin": null,
            "axisSoftMax": null
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "freeradius"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "VM freeradius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "db"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "VM db"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "grafana"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "VM grafana (monitoreo)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "r1"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "R1"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Líneas que mencionan un error, por máquina",
      "description": "Búsqueda de las palabras error, fatal, failed... Es orientativa: algunos mensajes normales las usan.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (instance) (count_over_time({instance=~\"$maquina\"} |~ \"(?i)\\\\b(error|fatal|panic|critical|failed)\\\\b\" [$__auto]))",
          "legendFormat": "{{instance}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisLabel": "",
            "showPoints": "never",
            "spanNulls": false,
            "barAlignment": 0,
            "axisSoftMin": null,
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "freeradius"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "VM freeradius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "db"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "VM db"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "grafana"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "VM grafana (monitoreo)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "r1"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "R1"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "FreeRADIUS y la base",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "FreeRADIUS: errores y avisos",
      "description": "rlm_sql = FreeRADIUS no llega a PostgreSQL (alerta FreeradiusSinBase). Los logins de cada abonado, con el motivo, están en el dashboard Abonados.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=\"freeradius\"} |~ \"Error|Warning\" |= \"$texto\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "PostgreSQL",
      "description": "Arranques, conexiones rechazadas (pg_hba), errores de consultas.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=\"postgres\"} |= \"$texto\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "R1 (syslog)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "R1: conexiones y cortes PPPoE (todos los abonados)",
      "description": "logged in / logged out (con bytes y MAC), authenticated, terminating.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{instance=\"r1\", topic=\"ppp\"} |= \"$texto\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "R1: RADIUS, configuración y sistema",
      "description": "Pedidos RADIUS sin respuesta, cambios de configuración (quién y qué), ingresos de administradores, reinicios.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{instance=\"r1\", topic=~\"radius|sistema\"} |= \"$texto\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Facturación (jobs en cron de la VM db)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Corridas y fallas por job",
      "description": "rehabilitar corre cada 5 min y suspender a las 03:00: si las barras se cortan, el job no está corriendo. Fallas = líneas de error (FALLÓ, psql, radclient).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (unit) (count_over_time({service=\"facturacion\"} |= \"Inicio\" [$__auto]))",
          "legendFormat": "{{unit}}",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (unit) (count_over_time({service=\"facturacion\", level=~\"error|critical|alert|emergency\"} [$__auto]))",
          "legendFormat": "{{unit}} · fallas",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisLabel": "",
            "showPoints": "never",
            "spanNulls": false,
            "barAlignment": 0,
            "axisSoftMin": null,
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "facturacion-rehabilitar"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "rehabilitar"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "facturacion-suspender"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "suspender"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*fallas"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Jobs de facturación",
      "description": "Quién fue suspendido o rehabilitado y si la orden de corte llegó (\"ATENCIÓN: no se pudo cortar\").",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"facturacion\"} |= \"$texto\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "id": 12,
      "gridPos": {
        "x": 8,
        "y": 27,
        "w": 16,
        "h": 8
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Sistema de las VMs: lo que no está en los contenedores",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Kernel y servicios del sistema",
      "description": "Falta de memoria (out of memory: Killed process), disco, red, Docker, accesos por SSH.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{instance=~\"$maquina\", unit=~\"kernel|docker.service|containerd.service|ssh.service\"} |= \"$texto\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      }
    }
  ]

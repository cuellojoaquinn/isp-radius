        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Conexiones en uso",
      "description": "Si se llena, nadie más se puede conectar: ni FreeRADIUS ni facturación. Alerta al 80 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pg_stat_activity_count) / max(pg_settings_max_connections)",
          "legendFormat": "ocupado",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pg_stat_activity_count)",
          "legendFormat": "en uso",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_settings_max_connections)",
          "legendFormat": "máximo",
          "instant": true,
          "range": false,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",

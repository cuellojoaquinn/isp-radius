    {
      "id": 9,
      "type": "timeseries",
      "title": "Tasa de quema · disponibilidad",
      "description": "Cuántas veces más rápido que lo permitido se consume el presupuesto. 1 = justo se agota en 30 días. Page si 1 h y 5 min > 14,4; ticket si 6 h y 30 min > 6.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:radius_auth_errores:ratio_rate1h / 0.001",
          "legendFormat": "ventana 1 h"
        },
        {
          "refId": "B",
          "expr": "slo:radius_auth_errores:ratio_rate5m / 0.001",
          "legendFormat": "ventana 5 min"
        },
        {
          "refId": "C",
          "expr": "slo:radius_auth_errores:ratio_rate6h / 0.001",
          "legendFormat": "ventana 6 h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 14.4
              },
              {
                "color": "orange",
                "value": 6
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Pedidos RADIUS (30 días)",

{
  "uid": "slos",
  "title": "Servicio RADIUS (SLOs)",
  "description": "Síntomas: los 4 SLIs de la bitácora (18/11), presupuesto de error y tasa de quema. Si algo está rojo acá, buscar la causa en Componentes.",
  "tags": [
    "isp-radius",
    "sintomas"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "title": "Componentes",
      "type": "link",
      "url": "/d/componentes",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/postgresql",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Infraestructura",
      "type": "link",
      "url": "/d/infraestructura",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/logs",
      "icon": "doc",
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Indicadores (SLI) contra objetivos (SLO) — vista de síntomas",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLI 1 · Disponibilidad (1 h)",
      "description": "(accepts + rejects) / requests de /radius monitor en R1. SLO 99,9 %. Un reject cuenta como bueno: rechazar una contraseña mal escrita es la respuesta correcta.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - slo:radius_auth_errores:ratio_rate1h",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "decimals": 2,
          "noValue": "sin pedidos"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLI 2 · Sin reenvíos (1 h)",
      "description": "1 - resends / requests. Latencia por política: cada reenvío es una respuesta más lenta que el timeout de R1 (3 s). SLO 99 %.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"

      "targets": [
        {
          "refId": "A",
          "expr": "1 - slo:radius_auth_reenvios:ratio_rate1h",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",

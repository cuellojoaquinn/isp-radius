# Copiar a mikrotik/.env y completar. El .env NO se sube al repo.
# Lo usa scripts/configurar-chr.sh.

# Contraseñas de admin de cada router. Se definen en el primer login de un CHR
# nuevo (admin viene sin contraseña).
R1_ADMIN_PASSWORD=cambiar-password-admin-r1
R2_ADMIN_PASSWORD=cambiar-password-admin-r2

# Contraseña PPPoE de abonado1 en R2. Tiene que coincidir con radcheck
# (db/init/03-datos.sql).
R2_PPPOE_PASSWORD=secreto1
